const sleep = ms => new Promise(r => setTimeout(r, ms));
(async () => {
  const execUrl = 'https://script.google.com/macros/s/AKfycbwabSXEa73Agrj0Wyo8vdk5p6KGLMBA2i9BQNJLbnxAYhMGlbO7J0cxZKqntktIs1K8/exec?action=log&d=manualredirect';
  const headers = {
    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/156.0.0.0 Safari/537.36',
    'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8',
    'Accept-Language': 'en-US,en;q=0.9',
    'Referer': 'https://script.google.com/',
    'Origin': 'https://script.google.com'
  };
  try {
    const r1 = await fetch(execUrl, { redirect: 'manual', headers });
    const loc = r1.headers.get('location');
    if (loc) {
      const r2 = await fetch(loc, { headers });
      await r2.text();
      await sleep(r2.status === 200 ? 20000 : 2000);
    } else {
      await sleep(2000);
    }
  } catch (e) {
    await sleep(2000);
  }
})();
